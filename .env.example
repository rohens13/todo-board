HUBSPOT_API_KEY=your_hubspot_private_app_token
ANTHROPIC_API_KEY=your_anthropic_key

# Basic auth. Leave BOTH blank to disable auth (local dev only).
# ADMIN_PASSWORD = full access. VIEWER_PASSWORD = CRM tab only.
ADMIN_PASSWORD=
VIEWER_PASSWORD=

# Path to data.json. Defaults to ./data.json. On Render set to /var/data/data.json.
DATA_FILE=
